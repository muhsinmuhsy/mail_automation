{
  "name": "mail-automation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "wrangler deploy --dry-run",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "stage:worker": "node scripts/deploy-worker.mjs --stage",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:gmail:live": "node scripts/test-gmail-live.mjs",
    "test:unit": "vitest run tests/unit",
    "check:local-production": "node scripts/check-production-readiness.mjs --local",
    "check:production": "node scripts/check-production-readiness.mjs",
    "postinstall": "node scripts/strip-editor-font.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@neondatabase/auth": "^0.5.0-beta",
    "@prisma/adapter-neon": "^6.7.0",
    "@prisma/client": "^7.10.0",
    "@templatical/editor": "0.34.0",
    "@templatical/renderer": "0.34.0",
    "@templatical/types": "0.34.0",
    "html-to-text": "9.0.5",
    "mjml": "5.4.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.1.0",
    "@vitest/ui": "^3.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.0.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.1.0",
    "wrangler": "^4.127.0"
  }
}
