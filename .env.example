# Neon Auth
NEON_AUTH_BASE_URL=
# Minimum 32 characters.
NEON_AUTH_COOKIE_SECRET=

# Database
DATABASE_URL=

# Backblaze B2 (S3-Compatible API)
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT=
# Backblaze application key ID. Do not use the master account key.
B2_KEY_ID=
# Backblaze application key secret for the key above.
B2_APPLICATION_KEY=

# Application
# Local development: http://localhost:3000
# Production: set to the deployed HTTPS origin.
NEXT_PUBLIC_APP_URL=
APP_VERSION=1.0.0
LOG_LEVEL=info

# Encryption
# 64-character hex string.
SMTP_ENCRYPTION_KEY=

# Test-only
# Set this to B2_BUCKET_NAME when intentionally running the live B2 integration
# test against a controlled bucket.
B2_TEST_BUCKET=

# Deployment CLI only
# Used by Wrangler commands such as `wrangler secret list`, `wrangler secret put`,
# and `wrangler deploy`. This is not a runtime app secret and should not be set
# as a Worker secret.
CLOUDFLARE_API_TOKEN=
