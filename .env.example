# Neon Auth
NEON_AUTH_BASE_URL=
# Minimum 32 characters.
NEON_AUTH_COOKIE_SECRET=

# Database
DATABASE_URL=

# Backblaze B2 (S3-Compatible API)
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT=
# Backblaze application key ID. Do not use the master account key.
B2_KEY_ID=
# Backblaze application key secret for the key above.
B2_APPLICATION_KEY=
# Public base URL for B2 objects (for email image URLs). Optional — if unset,
# derived from B2_ENDPOINT + B2_BUCKET_NAME (virtual-hosted style).
# Example: https://f000.backblazeb2.com/file/my-bucket
B2_PUBLIC_BASE_URL=

# Application (Vercel app/API)
# Local development: http://localhost:3000
# Local production readiness checks allow localhost.
# Public production deployments must use the deployed HTTPS origin.
NEXT_PUBLIC_APP_URL=
APP_VERSION=1.0.0
LOG_LEVEL=info

# Encryption
# 64-character hex string.
# Set in both Vercel and Cloudflare Worker secrets because both runtimes may
# read encrypted provider credentials.
SMTP_ENCRYPTION_KEY=

# Gmail sending OAuth (separate from Neon Auth Google sign-in)
# Web application OAuth client from Google Cloud; enable the Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the registered Google redirect URI and NEXT_PUBLIC_APP_URL origin.
# Local: http://localhost:3000/api/email-accounts/callback/gmail
GOOGLE_REDIRECT_URI=

# Cloudflare background Worker secrets
# Set these with `wrangler secret put` for the tiny Cron/Queue Worker.
# DATABASE_URL
# SMTP_ENCRYPTION_KEY
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# B2_BUCKET_NAME
# B2_REGION
# B2_ENDPOINT
# B2_KEY_ID
# B2_APPLICATION_KEY

# Deployment CLI only
# Used by Wrangler commands such as `wrangler secret list`, `wrangler secret put`,
# and `wrangler deploy`. This is not a runtime app secret and should not be set
# as a Worker secret.
CLOUDFLARE_API_TOKEN=
