generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
  runtime    = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum EmailProvider {
  gmail
  microsoft
  yahoo
  custom_smtp
}

enum AuthMethod {
  app_password
  oauth2
  password
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum EmailJobStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  RETRY_WAIT
  SENT
  FAILED
  CANCELLED
  DELIVERY_UNKNOWN
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  UNKNOWN
}

/// User-defined custom merge field types. See docs/CUSTOM_MERGE_FIELDS.md §11.3.
enum FieldType {
  text
  number
  date
  boolean
}

model User {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String   @unique @db.VarChar(255)
  name                      String?  @db.VarChar(255)
  role                      UserRole @default(USER)
  is_active                 Boolean  @default(true)
  daily_email_limit_override Int?
  created_at                DateTime @default(now()) @db.Timestamptz

  email_accounts    EmailAccount[]
  attachments       Attachment[]
  contacts          Contact[]
  templates         Template[]
  campaigns         Campaign[]
  email_jobs        EmailJob[]
  email_usage_daily EmailUsageDaily[]
  reservations      EmailSendReservation[]
  contact_fields    ContactField[]

  @@map("users")
}

model EmailAccount {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String    @db.Uuid
  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  provider               EmailProvider
  email                  String    @db.VarChar(255)
  auth_method            AuthMethod
  encrypted_secret       String?
  encrypted_refresh_token String?
  access_token_expires_at DateTime? @db.Timestamptz
  provider_account_id    String?
  granted_scopes         String[] @default([])
  connection_error       String?
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @updatedAt @default(now()) @db.Timestamptz

  campaigns   Campaign[]
  email_jobs  EmailJob[]

  @@unique([user_id, provider, email], map: "unique_email_accounts_user_provider_email")
  @@map("email_accounts")
}

// Short-lived, single-use authorization attempts. No OAuth secrets in URLs.
model EmailOAuthAttempt {
  state_hash         String @id
  user_id            String @db.Uuid
  provider           EmailProvider
  account_id         String? @db.Uuid
  encrypted_verifier String
  expires_at         DateTime @db.Timestamptz

  @@index([expires_at])
  @@map("email_oauth_attempts")
}

model Attachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  filename   String   @db.VarChar(255)
  storage_key String  @db.VarChar(1024)
  size_bytes Int?
  is_default Boolean  @default(false)
  deleted_at DateTime? @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @default(now()) @db.Timestamptz

  campaigns  Campaign[]
  email_jobs EmailJob[]

  @@index([user_id], map: "idx_attachments_user_id")
  @@map("attachments")
}

model Contact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name       String?  @db.VarChar(100)
  email      String   @db.VarChar(255)
  /// Set only during CSV imports for idempotent retry (see §11.27). Nullable;
  /// existing contacts have null and require no backfill.
  import_session_id String? @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @default(now()) @db.Timestamptz

  email_jobs         EmailJob[]
  contact_field_values ContactFieldValue[]

  @@index([user_id, email], map: "idx_contacts_user_id_email")
  @@index([user_id, import_session_id], map: "idx_contacts_user_id_import_session_id")
  @@map("contacts")
}

/// User-defined custom merge field definition (Path C hybrid model).
/// See docs/CUSTOM_MERGE_FIELDS.md §3.1 and Phase 1.
model ContactField {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// The merge token, e.g. `size`. Lowercase, alphanumeric + underscore.
  /// Unique per user. Must not collide with reserved tokens (§11.2).
  /// Immutable after creation because templates reference it.
  name       String   @db.VarChar(50)
  /// Display label, e.g. "T-shirt size". Mutable.
  label      String   @db.VarChar(100)
  field_type FieldType @default(text)
  sort_order Int      @default(0)
  is_required Boolean @default(false)
  /// Reserved for future seeded defaults; not used in the hybrid model.
  is_default Boolean  @default(false)
  /// Optimistic concurrency control (§11.24). Incremented on every PATCH.
  /// Checked (not incremented) on DELETE.
  version    Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @default(now()) @db.Timestamptz

  contact_field_values ContactFieldValue[]

  @@unique([user_id, name], map: "unique_contact_fields_user_id_name")
  @@index([user_id], map: "idx_contact_fields_user_id")
  @@map("contact_fields")
}

/// Per-contact value for a user-defined custom merge field.
/// `value` is stored as text; interpretation depends on the parent field's
/// `field_type`. Nullable for optional fields. See §11.18 for value limits.
model ContactFieldValue {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id String   @db.Uuid
  contact    Contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  field_id   String   @db.Uuid
  field      ContactField @relation(fields: [field_id], references: [id], onDelete: Cascade)
  /// Stored as text. The 10,000-char limit (§11.14) is enforced in validation.
  value      String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @default(now()) @db.Timestamptz

  @@unique([contact_id, field_id], map: "unique_contact_field_values_contact_id_field_id")
  @@index([field_id], map: "idx_contact_field_values_field_id")
  @@map("contact_field_values")
}

model Template {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(100)
  subject    String   @db.VarChar(200)
  /// Templatical editor JSON (source of truth). Null for legacy plain-text templates.
  body_json  String?  @db.Text
  /// Server-rendered MJML from @templatical/renderer. Derived cache from body_json.
  body_mjml  String?  @db.Text
  /// Server-compiled HTML from the mjml package. Derived cache from body_mjml.
  body_html  String?  @db.Text
  /// Plain-text fallback derived from body_html. Legacy `body` migrates here.
  body_text  String?  @db.Text
  /// DEPRECATED: retained for backward compat during migration. Equals body_text for new templates.
  body       String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @default(now()) @db.Timestamptz

  campaigns  Campaign[]
  email_jobs EmailJob[]

  @@index([user_id], map: "idx_templates_user_id")
  @@map("templates")
}

model Campaign {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String           @db.Uuid
  user               User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  email_account_id   String           @db.Uuid
  email_account      EmailAccount     @relation(fields: [email_account_id], references: [id])
  attachment_id      String?           @db.Uuid
  attachment         Attachment?       @relation(fields: [attachment_id], references: [id])
  attachment_ids String[] @default([]) @db.Uuid
  template_id        String           @db.Uuid
  template           Template         @relation(fields: [template_id], references: [id])
  name               String           @db.VarChar(255)
  start_at           DateTime         @db.Timestamptz
  timezone           String           @default("UTC") @db.VarChar(64)
  interval_minutes   Int              @default(5)
  daily_limit        Int?
  status             CampaignStatus   @default(DRAFT)
  created_at         DateTime         @default(now()) @db.Timestamptz
  updated_at         DateTime         @updatedAt @default(now()) @db.Timestamptz

  email_jobs    EmailJob[]
  usage_daily   CampaignUsageDaily[]
  reservations  EmailSendReservation[]

  @@index([user_id, status], map: "idx_campaigns_user_id_status")
  @@map("campaigns")
}

model EmailJob {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String        @db.Uuid
  user                    User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  campaign_id             String?       @db.Uuid
  campaign                Campaign?     @relation(fields: [campaign_id], references: [id])
  contact_id              String        @db.Uuid
  contact                 Contact       @relation(fields: [contact_id], references: [id])
  email_account_id        String        @db.Uuid
  email_account           EmailAccount  @relation(fields: [email_account_id], references: [id])
  attachment_id           String?        @db.Uuid
  attachment              Attachment?    @relation(fields: [attachment_id], references: [id])
  attachment_ids String[] @default([]) @db.Uuid
  template_id             String        @db.Uuid
  template                Template      @relation(fields: [template_id], references: [id])
  to_email                String        @db.VarChar(255)
  subject                 String        @db.VarChar(255)
  body                    String        @db.Text
  /// Resolved HTML snapshot (merge tags already substituted). Null for legacy text-only jobs.
  body_html               String?       @db.Text
  scheduled_at            DateTime      @db.Timestamptz
  status                  EmailJobStatus @default(SCHEDULED)
  attempt_count           Int           @default(0)
  processing_started_at   DateTime?     @db.Timestamptz
  next_attempt_at         DateTime?     @db.Timestamptz
  sent_at                 DateTime?     @db.Timestamptz
  error_message           String?
  created_at              DateTime      @default(now()) @db.Timestamptz
  updated_at              DateTime      @updatedAt @default(now()) @db.Timestamptz

  email_logs     EmailLog[]
  reservations   EmailSendReservation[]

  @@index([status, scheduled_at], map: "idx_email_jobs_status_scheduled_at")
  @@index([user_id, status], map: "idx_email_jobs_user_id_status")
  @@index([campaign_id], map: "idx_email_jobs_campaign_id")
  @@index([email_account_id], map: "idx_email_jobs_email_account_id")
  @@index([next_attempt_at], map: "idx_email_jobs_next_attempt_at")
  @@map("email_jobs")
}

model EmailLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email_job_id String   @db.Uuid
  email_job    EmailJob @relation(fields: [email_job_id], references: [id], onDelete: Cascade)
  status       String   @db.VarChar(50)
  smtp_response String?
  error_message String?
  created_at   DateTime @default(now()) @db.Timestamptz

  @@index([email_job_id], map: "idx_email_logs_email_job_id")
  @@map("email_logs")
}

model SystemSetting {
  id                        Int     @id @default(1)
  default_daily_email_limit Int     @default(20)
  global_daily_email_limit  Int     @default(500)
  email_sending_enabled     Boolean @default(true)
  updated_at                DateTime @updatedAt @default(now()) @db.Timestamptz

  @@map("system_settings")
}

model EmailUsageDaily {
  user_id       String   @db.Uuid
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  usage_date    DateTime @db.Date
  sent_count    Int      @default(0)
  reserved_count Int     @default(0)

  @@id([user_id, usage_date])
  @@map("email_usage_daily")
}

model CampaignUsageDaily {
  campaign_id   String   @db.Uuid
  campaign      Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  usage_date    DateTime @db.Date
  sent_count    Int      @default(0)
  reserved_count Int     @default(0)

  @@id([campaign_id, usage_date])
  @@map("campaign_usage_daily")
}

model EmailSendReservation {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email_job_id   String        @db.Uuid
  email_job      EmailJob      @relation(fields: [email_job_id], references: [id], onDelete: Cascade)
  attempt_number Int           @default(1)
  user_id        String        @db.Uuid
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  campaign_id    String?       @db.Uuid
  campaign       Campaign?     @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  usage_date     DateTime      @db.Date
  status         ReservationStatus @default(RESERVED)
  created_at     DateTime      @default(now()) @db.Timestamptz
  resolved_at    DateTime?     @db.Timestamptz

  @@unique([email_job_id, attempt_number], map: "unique_reservations_job_attempt")
  @@index([email_job_id], map: "idx_reservations_email_job_id")
  @@index([user_id, usage_date], map: "idx_reservations_user_id_usage_date")
  @@index([campaign_id], map: "idx_reservations_campaign_id")
  @@map("email_send_reservations")
}

model SystemUsageDaily {
  usage_date     DateTime @id @db.Date
  sent_count     Int      @default(0)
  reserved_count Int      @default(0)

  @@map("system_usage_daily")
}
